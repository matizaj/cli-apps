{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug scan package tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/scan",
      "env": {
        "GOWORK": "off"
      },
      "showLog": true
    },
    {
      "name": "Debug scanHosts tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/scan",
      "args": [
        "-test.v",
        "-test.run",
        "TestStateString|TestRunHostFound|TestRunHostNotFound"
      ],
      "env": {
        "GOWORK": "off"
      },
      "showLog": true
    },
    {
      "name": "Debug current Go test file",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": [
        "-test.v"
      ],
      "env": {
        "GOWORK": "off"
      },
      "showLog": true
    },
    {
      "name": "Debug pScan main",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "env": {
        "GOWORK": "off"
      },
      "args": []
    }
  ]
}
